# Copie para .env.local e ajuste se o acervo estiver em outro disco
MATERIALS_ROOT=E:\GIT\Portulebre\Materials

# Admin (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=altere-senha-forte
ADMIN_SECRET_KEY=
CRON_SECRET=altere-cron-secret

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SITE_URL=https://celpe-depe.com
CF_API_TOKEN=
CF_ZONE_ID=

# Perplexity API (server-side only — never expose to the client)
# Prefer CELPE key; fallback to PERPLEXITY_API_KEY
PERPLEXITY_API_KEY_CELPE=
PERPLEXITY_API_KEY=

# Brave Search API (server-side only)
BRAVE_API_KEY_CELPE=
BRAVE_API_KEY=

# Bing Webmaster Tools API (server-side only)
# Key: Bing Webmaster → Settings → API Access (NOT Azure Web Search)
BING_WEBMASTER_API_KEY_CELPE=
BING_WEBMASTER_API_KEY=
BING_WEBMASTER_SITE_URL=https://celpe-depe.com/
BING_WEBMASTER_API_BASE=https://ssl.bing.com/webmaster/api.svc/json

# IndexNow (Bing/Yandex URL push on blog publish)
# Generate a UUID-like key; served at https://celpe-depe.com/{INDEXNOW_KEY}.txt
INDEXNOW_KEY=
