# Copie para .env.local e ajuste se o acervo estiver em outro disco
MATERIALS_ROOT=E:\GIT\Portulebre\Materials

# Admin (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=altere-senha-forte
ADMIN_SECRET_KEY=
CRON_SECRET=altere-cron-secret

# Analytics (opcional)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_SITE_URL=https://celpe-depe.com
CF_API_TOKEN=
CF_ZONE_ID=

# Essay checker / writer (OpenAI-compatible). In dev, falls back to a seeded local mock if unset.
ESSAY_LLM_API_KEY=
OPENAI_API_KEY=
ESSAY_LLM_BASE_URL=https://api.openai.com/v1
ESSAY_LLM_MODEL=gpt-4.1-mini
# 1 = the "ver exemplo" mock path is offered in the UI. Set 0 in production to charge only the real model.
ESSAY_CHECK_ALLOW_MOCK=1

# Writer observability (see deploy/DEPLOY.md → «Раздел «Escrever» (проверка эссе)»)
# SQLite canonical store. Default: data/admin/admin.db
# ADMIN_DB_PATH=./data/admin/admin.db
# Readable JSON copies of every checked essay, dated by submission id. Default: data/writing
WRITER_ARCHIVE_DIR=./data/writing
# HMAC key for report tokens. Falls back to ADMIN_SECRET_KEY. Changing it invalidates every link already sent.
WRITER_REPORT_PEPPER=
# Days a /{locale}/writing/report/{token} link stays open. Default: 30
WRITING_REPORT_TTL_DAYS=30
# Absolute base URL used to build report links (falls back to NEXT_PUBLIC_SITE_URL).
SITE_URL=https://celpe-depe.com
# Resend (https://resend.com). Without both a key and a sender address, sending is skipped and
# recorded as "skipped_unconfigured": the candidate still sees the result on screen.
RESEND_API_KEY=
MAIL_FROM=Celpe-Dê Pé <no-reply@celpe-depe.com>
RESEND_FROM=
MAIL_REPLY_TO=

# Perplexity API (server-side only — never expose to the client)
# Prefer CELPE key; fallback to PERPLEXITY_API_KEY
PERPLEXITY_API_KEY_CELPE=
PERPLEXITY_API_KEY=

# Brave Search API (server-side only)
BRAVE_API_KEY_CELPE=
BRAVE_API_KEY=

# Bing Webmaster Tools API (server-side only)
# Key: Bing Webmaster → Settings → API Access (NOT Azure Web Search)
BING_WEBMASTER_API_KEY_CELPE=
BING_WEBMASTER_API_KEY=
BING_WEBMASTER_SITE_URL=https://celpe-depe.com/
BING_WEBMASTER_API_BASE=https://ssl.bing.com/webmaster/api.svc/json

# IndexNow (Bing/Yandex URL push on blog publish)
# Generate a UUID-like key; served at https://celpe-depe.com/{INDEXNOW_KEY}.txt
INDEXNOW_KEY=
